<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Keep NuGet security-audit findings visible as warnings, but don't fail the build on
         transitive vulnerabilities we don't control. Resolve them later by pinning a patched version. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Only audit packages we reference directly (transitive noise off). -->
    <NuGetAuditMode>direct</NuGetAuditMode>

    <!-- One shared user-secrets store for every app in the repo (Development only); populated by
         scripts/setup-secrets.ps1 from the git-ignored .env. Never put secrets in appsettings.json. -->
    <UserSecretsId>fleetiq-local-dev</UserSecretsId>
  </PropertyGroup>
</Project>