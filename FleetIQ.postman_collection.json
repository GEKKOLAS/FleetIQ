{
  "info": {
    "name": "FleetIQ API (all services via gateway)",
    "description": "Run '0 - Get Token' first; the bearer token is stored and reused. All calls go through the YARP gateway on {{baseUrl}}. In Postman Settings, turn OFF 'SSL certificate verification' for the local dev certs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string"
    },
    {
      "key": "idpUrl",
      "value": "https://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "ordersId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "carrierId",
      "value": "",
      "type": "string"
    },
    {
      "key": "loadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shipmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportDefinitionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "complianceCheckId",
      "value": "",
      "type": "string"
    },
    {
      "key": "integrationConnectorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "predictionRequestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0 - Get Token (run first)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "fleetiq.service"
            },
            {
              "key": "client_secret",
              "value": "REDACTED"
            },
            {
              "key": "scope",
              "value": "fleetiq.api"
            }
          ]
        },
        "url": {
          "raw": "{{idpUrl}}/connect/token",
          "host": [
            "{{idpUrl}}"
          ],
          "path": [
            "connect",
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.access_token) {",
              "    pm.collectionVariables.set('token', json.access_token);",
              "    console.log('Token saved');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Orders",
      "item": [
        {
          "name": "Create Orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{$guid}}\",\n  \"pickup\": {\n    \"street\": \"1 Main St\",\n    \"city\": \"Lisbon\",\n    \"postalCode\": \"1000-001\",\n    \"country\": \"PT\"\n  },\n  \"delivery\": {\n    \"street\": \"5 Park Ave\",\n    \"city\": \"Porto\",\n    \"postalCode\": \"4000-002\",\n    \"country\": \"PT\"\n  },\n  \"items\": [\n    {\n      \"description\": \"Pallet\",\n      \"quantity\": 2,\n      \"weightKg\": 120\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.id) { pm.collectionVariables.set('ordersId', json.id); }",
                  "pm.test('created', function () { pm.expect([200,201]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Orders by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{ordersId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{ordersId}}"
              ]
            }
          }
        }
      ]
    },
