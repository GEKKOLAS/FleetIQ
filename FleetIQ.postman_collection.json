{
  "info": {
    "name": "FleetIQ API (all services via gateway)",
    "description": "Run '0 - Get Token' first. Orders (01) and Billing (06) are the complete rich services. Turn OFF SSL verification in Postman settings.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "idpUrl",
      "value": "https://localhost:5001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "userAccountId",
      "value": ""
    },
    {
      "key": "carrierId",
      "value": ""
    },
    {
      "key": "loadId",
      "value": ""
    },
    {
      "key": "shipmentId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "reportDefinitionId",
      "value": ""
    },
    {
      "key": "complianceCheckId",
      "value": ""
    },
    {
      "key": "integrationConnectorId",
      "value": ""
    },
    {
      "key": "predictionRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Get Token (run first)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "fleetiq.service"
            },
            {
              "key": "client_secret",
              "value": "REDACTED"
            },
            {
              "key": "scope",
              "value": "fleetiq.api"
            }
          ]
        },
        "url": {
          "raw": "{{idpUrl}}/connect/token",
          "host": [
            "{{idpUrl}}"
          ],
          "path": [
            "connect",
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j=pm.response.json();",
              "if(j&&j.access_token){pm.collectionVariables.set('token',j.access_token);console.log('token saved');}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Orders (complete service)",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"pickup\": {\n    \"street\": \"1 Main St\",\n    \"city\": \"Lisbon\",\n    \"postalCode\": \"1000-001\",\n    \"country\": \"PT\"\n  },\n  \"delivery\": {\n    \"street\": \"5 Park Ave\",\n    \"city\": \"Porto\",\n    \"postalCode\": \"4000-002\",\n    \"country\": \"PT\"\n  },\n  \"items\": [\n    {\n      \"description\": \"Pallet\",\n      \"quantity\": 2,\n      \"weightKg\": 120\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j=pm.response.json();",
                  "if(j&&j.id) pm.collectionVariables.set('orderId',j.id);",
                  "pm.test('ok',function(){pm.expect([200,201,204]).to.include(pm.response.code);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "List Orders (paged/filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?customerId={{customerId}}&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Add Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Box\",\n  \"quantity\": 3,\n  \"weightKg\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/confirm",
              "host": [
