# Copy to .env - or just run scripts/setup-secrets.ps1, which creates .env with random values
# and loads them into the shared .NET user-secrets store. .env is git-ignored; never commit it.
POSTGRES_USER=fleetiq
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=fleetiq
RABBITMQ_DEFAULT_PASS=
MINIO_ROOT_USER=fleetiq
MINIO_ROOT_PASSWORD=
# OAuth client secret for client_id=fleetiq.service (client_credentials)
FLEETIQ_SERVICE_CLIENT_SECRET=
# Password for the demo users alice / bob
FLEETIQ_DEMO_USER_PASSWORD=
