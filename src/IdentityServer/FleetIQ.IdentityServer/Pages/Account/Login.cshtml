@page
@model FleetIQ.IdentityServer.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FleetIQ — Sign in</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
               background: linear-gradient(135deg, #102A43 0%, #0A1E30 100%); color: #1a2027;
               min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { background: #fff; border-radius: 16px; padding: 40px 36px; width: 380px; box-shadow: 0 20px 60px rgba(0,0,0,.35); }
        .brand { font-size: 26px; font-weight: 800; color: #102A43; text-align: center; }
        .sub { color: #5A6778; text-align: center; margin: 6px 0 24px; }
        label { display: block; font-size: 13px; font-weight: 600; color: #102A43; margin: 14px 0 6px; }
        input { width: 100%; padding: 11px 12px; border: 1px solid #DCE5EE; border-radius: 8px; font-size: 14px; }
        input:focus { outline: none; border-color: #128C7E; }
        button { width: 100%; margin-top: 22px; padding: 12px; border: none; border-radius: 8px; background: #128C7E;
                 color: #fff; font-size: 15px; font-weight: 600; cursor: pointer; }
        button:hover { background: #0f7567; }
        .error { background: #FBE7E7; color: #a52727; border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-bottom: 8px; }
        .hint { margin-top: 18px; font-size: 12px; color: #8895A7; text-align: center; }
        .hint code { background: #F2F6FA; padding: 1px 6px; border-radius: 5px; }
        .dot { width: 30px; height: 30px; border-radius: 50%; background: #02C39A; margin: 0 auto 10px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="dot"></div>
        <div class="brand">FleetIQ</div>
        <div class="sub">Sign in to continue</div>

        @if (Model.ErrorMessage != null)
        {
            <div class="error">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autofocus autocomplete="username" />
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
            <button type="submit">Sign in</button>
        </form>

        <div class="hint">Demo users: <strong>alice</strong> / <strong>bob</strong> — ask the FleetIQ team for the password</div>
    </div>
</body>
</html>
