{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Authentication": {
    "Authority": "https://localhost:5001",
    "Audience": "fleetiq.api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "useraccounts-route": {
        "ClusterId": "useraccounts-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/useraccounts/{**catch-all}"
        }
      },
      "carriers-route": {
        "ClusterId": "carriers-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/carriers/{**catch-all}"
        }
      },
      "loads-route": {
        "ClusterId": "loads-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/loads/{**catch-all}"
        }
      },
      "routes-route": {
        "ClusterId": "loads-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/routes/{**catch-all}"
        }
      },
      "shipments-route": {
        "ClusterId": "shipments-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/shipments/{**catch-all}"
        }
      },
      "invoices-route": {
        "ClusterId": "invoices-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/invoices/{**catch-all}"
        }
      },
      "documents-route": {
        "ClusterId": "documents-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/documents/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      },
      "reportdefinitions-route": {
        "ClusterId": "reportdefinitions-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/reportdefinitions/{**catch-all}"
        }
      },
      "compliancechecks-route": {
        "ClusterId": "compliancechecks-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/compliancechecks/{**catch-all}"
        }
      },
      "integrationconnectors-route": {
        "ClusterId": "integrationconnectors-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/integrationconnectors/{**catch-all}"
        }
      },
      "predictionrequests-route": {
        "ClusterId": "predictionrequests-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/predictionrequests/{**catch-all}"
        }
      },
      "tracking-hub-route": {
        "ClusterId": "shipments-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/hubs/tracking/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5081/"
          }
        }
      },
      "useraccounts-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5082/"
          }
        }
      },
      "carriers-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5083/"
          }
        }
      },
      "loads-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5084/"
          }
        }
      },
      "shipments-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5085/"
          }
        }
      },
      "invoices-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5086/"
          }
        }
      },
      "documents-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5087/"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5088/"
          }
        }
      },
      "reportdefinitions-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5089/"
          }
        }
      },
      "compliancechecks-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5090/"
          }
        }
      },
      "integrationconnectors-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5091/"
          }
        }
      },
      "predictionrequests-cluster": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:5092/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
